# OpenAI — used for LLM calls (plan, outline, draft, review, polish)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# DashScope (阿里云百炼) — used for web search via a Bailian single-agent application (ADR-0010)
DASHSCOPE_API_KEY=sk-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MCP_APP_ID=your-bailian-app-id

# Redis 8.0+ with RedisJSON + RediSearch — LangGraph checkpointer
REDIS_URL=redis://localhost:6379

LOG_LEVEL=INFO